From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Mon, 16 Nov 2026 14:04:52 +0000
Subject: [PATCH] Build with current MinGW headers.

Wheelio: CrossOver's DXVK (1.10.3) predates headers that now come with
MinGW: D3DDEVINFO_RESOURCEMANAGER and ID3D10StateBlock's UUID are declared
there, and declaring them again is an error. engine/build.sh also builds it
with -include cstdint, for GCC 13 and later, which no longer include it
indirectly.

Origin: Wheelio.
---
 src/d3d10/d3d10_interfaces.h | 2 --
 src/d3d9/d3d9_include.h      | 6 ------
 2 files changed, 8 deletions(-)

diff --git a/src/d3d10/d3d10_interfaces.h b/src/d3d10/d3d10_interfaces.h
index aa028ab..b68b59b 100644
--- a/src/d3d10/d3d10_interfaces.h
+++ b/src/d3d10/d3d10_interfaces.h
@@ -4,6 +4,4 @@
 
 #ifdef _MSC_VER
 struct __declspec(uuid("0803425a-57f5-4dd6-9465-a87570834a08")) ID3D10StateBlock;
-#else
-__CRT_UUID_DECL(ID3D10StateBlock, 0x0803425a,0x57f5,0x4dd6,0x94,0x65,0xa8,0x75,0x70,0x83,0x4a,0x08);
 #endif
diff --git a/src/d3d9/d3d9_include.h b/src/d3d9/d3d9_include.h
index 8762265..478764c 100644
--- a/src/d3d9/d3d9_include.h
+++ b/src/d3d9/d3d9_include.h
@@ -77,13 +77,7 @@
 #define D3DPRESENT_FORCEIMMEDIATE              0x00000100L
 #endif
 
-// MinGW headers are broken. Who'dve guessed?
 #ifndef _MSC_VER
-typedef struct _D3DDEVINFO_RESOURCEMANAGER
-{
-  char dummy;
-} D3DDEVINFO_RESOURCEMANAGER, * LPD3DDEVINFO_RESOURCEMANAGER;
-
 #ifndef __WINE__
 extern "C" WINUSERAPI WINBOOL WINAPI SetProcessDPIAware(VOID);
 #endif
